OPENAI_API_KEY=pon-tu-clave-de-OpenAI-aqui
OPENAI_MODEL=gpt-6-luna
# Keep false until both media providers are configured. OPENAI_MEDIA_ENABLED remains supported for older deployments.
MEDIA_ENABLED=false
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Leave empty for local SQLite. On Render, use the pooled PostgreSQL URL from Neon.
DATABASE_URL=
PORT=3000
DATA_DIR=./data
